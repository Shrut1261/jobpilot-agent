# --- Option A: direct Gemini API key (fastest for local dev) ---
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Option B: Vertex AI (used automatically in Cloud Run if you set these
#     and flip USE_VERTEXAI to TRUE; also satisfies the hackathon's
#     "Vertex AI" option instead of a raw API key) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-3.7-flash

# Set to 1 to force local JSON storage instead of Firestore (no GCP needed)
JOBPILOT_DISABLE_FIRESTORE=0
